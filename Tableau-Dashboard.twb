      <aliases enabled='yes' />
      <column caption='Alternate Phone Number' datatype='string' name='[AlternatePhoneNumber]' role='dimension' type='nominal' />
      <column caption='Amount Billed' datatype='real' name='[AmountBilled]' role='measure' type='quantitative' />
      <column caption='Bill Date' datatype='datetime' name='[BillDate]' role='dimension' type='ordinal' />
      <column caption='Bill ID' datatype='integer' name='[BillID]' role='dimension' type='ordinal' />
      <column caption='Blood Type' datatype='string' name='[BloodType]' role='dimension' type='nominal' />
      <column caption='Total Patients' datatype='integer' name='[Calculation_0635839335112709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([PatientID])' />
      </column>
      <column caption='Follow-Up Rate' datatype='real' name='[Calculation_0635839335555078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [FollowUpRequired] = &quot;Yes&quot; THEN [VisitID] END) &#13;&#10;/ &#13;&#10;COUNT([VisitID])' />
      </column>
      <column caption='Average Cost' datatype='real' name='[Calculation_0635839336017927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([AmountBilled])' />
      </column>
      <column caption='Average Visits' datatype='real' name='[Calculation_0635839337377800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([VisitID]) / COUNTD([DoctorID])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0635839353933837]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 20 THEN &quot;Youth&quot;&#13;&#10;ELSEIF [Age] &lt;= 40 THEN &quot;Young Adult&quot;&#13;&#10;ELSEIF [Age] &lt;= 60 THEN &quot;Adult&quot;&#13;&#10;ELSE &quot;Senior&quot;&#13;&#10;END' />
      </column>
      <column caption='Chronic Conditions' datatype='string' name='[ChronicConditions]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Clinic Name' datatype='string' name='[ClinicName]' role='dimension' type='nominal' />
